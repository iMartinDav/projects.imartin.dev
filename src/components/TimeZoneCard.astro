---
import { formatParisTime } from "../lib/helpers";
import Card from "./Card/index.astro";

const now = new Date();
---

<script>
  import { formatParisTime } from "../lib/helpers";

  const timeDisplay = document.getElementById("timeDisplay");

  const updateClock = () => {
    if (!timeDisplay) return;
    const now = new Date();
    timeDisplay.textContent = formatParisTime(now);
    timeDisplay.setAttribute("datetime", now.toISOString());
  };

  updateClock();
  setInterval(updateClock, 1000);
</script>

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4" title="Local Time:">
  <!-- <div class="text-xl md:text-lg lg:text-2xl text-neutral-100/70">
    Orange County, CA.
  </div> -->

  <time
    datetime={now.toISOString()}
    id="timeDisplay"
    class="text-3xl md:text-2xl lg:text-5xl flex f-bold h-full mt-5"
  >
    {formatParisTime(now)}
  </time>
</Card>
